################################################################################
# ICC2 Library Creation Script
# TSMC 130nm – Tech LEF + Macro LEF (NO MERGE)
# Compatible with ICC2 LM O-2018.06
################################################################################
# =========================
# Paths
# =========================
set WORK_PATH     "../runtime"
../runtime
set OUTPUT_PATH   "../output"
../output
set LEF_DIR       "../lef"
../lef
set STD_CELLS_DIR "../std_cells"
../std_cells
# =========================
# Create required folders
# =========================
file mkdir $WORK_PATH
file mkdir $OUTPUT_PATH
# =========================
# Search Path
# =========================
set search_path [list . $LEF_DIR $STD_CELLS_DIR]
. ../lef ../std_cells
# =========================
# Library Name
# =========================
set NDM_LIB_NAME "tsmc13_std.ndm"
tsmc13_std.ndm
# =========================
# LEF Files
# =========================
# >>> Choose ONE technology LEF only <<<
set TECH_LEF "tsmc13fsg_6lm_tech.lef"
tsmc13fsg_6lm_tech.lef
# Standard cell macro LEF
set MACRO_LEF "tsmc13_m_macros.lef"
tsmc13_m_macros.lef
# Timing DB
set DB_FILE "scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.db"
scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.db
# =========================
# Cleanup old outputs
# =========================
file delete -force $NDM_LIB_NAME
file delete -force "$OUTPUT_PATH/$NDM_LIB_NAME"
# =========================
# Create Workspace with Technology LEF
# =========================
puts "Step 1: Creating workspace with Technology LEF..."
Step 1: Creating workspace with Technology LEF...
create_workspace $NDM_LIB_NAME     -flow normal     -technology $TECH_LEF
