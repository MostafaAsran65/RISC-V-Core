################################################################################
# ICC2 Library Creation Script (TSMC 130nm - Fixed Files)
################################################################################
set WORK_PATH     "../runtime"
../runtime
set OUTPUT_PATH   "../output"
../output
set LEF_DIR       "../lef"
../lef
set STD_CELLS_DIR "../std_cells"
../std_cells
file mkdir $WORK_PATH
file mkdir $OUTPUT_PATH
set search_path [list . $LEF_DIR $STD_CELLS_DIR]
. ../lef ../std_cells
set NDM_LIB_NAME "tsmc13_std.ndm"
tsmc13_std.ndm
# ==========================================
# ⚠️ استخدام الملفات اللي عدلناها حالا
# ==========================================
set TECH_LEF  "tsmc13_tech_fixed.lef"
tsmc13_tech_fixed.lef
set MACRO_LEF "tsmc13_macro_fixed.lef"
tsmc13_macro_fixed.lef
set DB_FILE   "scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.db"
scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.db
# تنظيف أي محاولات سابقة
file delete -force $NDM_LIB_NAME
file delete -force "$OUTPUT_PATH/$NDM_LIB_NAME"
puts "Step 1: Creating Workspace..."
Step 1: Creating Workspace...
# بما إننا ضفنا سطر TECHNOLOGY ونظفنا الملف، الأمر ده هيشتغل دلوقتي
create_workspace $NDM_LIB_NAME -flow normal -technology $TECH_LEF
